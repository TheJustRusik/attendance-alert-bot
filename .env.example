BOT_TOKEN=123456:ABC-your-token-from-BotFather
DATABASE_URL=postgres://bot:bot@localhost:5432/attendance
REDIS_URL=redis://localhost:6379

# Telegram ID админов через запятую.
# Используется ТОЛЬКО если в базе ещё нет ни одного админа.
ADMIN_IDS=123456789,987654321

# Кулдаун между уведомлениями (сек). По умолчанию 600 = 10 минут
NOTIFY_COOLDOWN_SEC=600
